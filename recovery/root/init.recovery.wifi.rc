# SM8750 / sun Qualcomm Wi-Fi recovery support.

on init
    chown root wifi /tmp
    chmod 0775 /tmp
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0770 root wifi
    chown root wifi /tmp/recovery/sockets
    chmod 0770 /tmp/recovery/sockets
    mkdir /data/misc 0771 system system
    mkdir /data/misc/wifi 0771 wifi wifi
    mkdir /data/vendor 0771 system system
    mkdir /data/vendor/firmware 0771 system system
    mkdir /data/vendor/firmware/update 0771 system system
    mkdir /data/vendor/firmware/update/wlan 0771 system system

on early-boot
    write /sys/kernel/icnss/wlan_en_delay 1000
    write /sys/kernel/icnss/wpss_boot 1
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

# One image serves the whole family, and the family has two WLAN chips: kiwi
# (warsaw) and peach (the rest). variant-script reads the chip off the cnss
# device-tree node and names it in ro.twrp.wlan_chip, so each branch below
# fires only on the device that has that chip. The cnss chain itself
# (cnss_prealloc .. cfg80211) is in TW_LOAD_VENDOR_MODULES and is up by the
# time twrp.firmware.mounted is set.
on property:twrp.firmware.mounted=true && property:ro.twrp.wlan_chip=peach_v2
    chmod 0222 /sys/devices/platform/soc/b0000000.qcom,cnss-peach/fs_ready
    write /sys/devices/platform/soc/b0000000.qcom,cnss-peach/fs_ready 1
    insmod /vendor/lib/modules/qca_cld3_peach_v2.ko
    setprop twrp.wifi.driver.loaded true

on property:twrp.firmware.mounted=true && property:ro.twrp.wlan_chip=kiwi_v2
    chmod 0222 /sys/devices/platform/soc/b0000000.qcom,cnss-kiwi/fs_ready
    write /sys/devices/platform/soc/b0000000.qcom,cnss-kiwi/fs_ready 1
    insmod /vendor/lib/modules/qca_cld3_kiwi_v2.ko
    setprop twrp.wifi.driver.loaded true

# The interface only appears once the firmware download finishes, which is
# right on ten seconds here, so a shorter timeout expired about as often as it
# succeeded and wpa_supplicant started against nothing and exited.
on property:twrp.wifi.driver.loaded=true
    wait /sys/class/net/wlan0 30
    setprop twrp.wifi.driver.ready true

on property:twrp.wifi.driver.ready=true
    start wpa_supplicant

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -c/system/etc/wifi/wpa_supplicant.conf
    class main
    user root
    group root wifi inet net_admin
    capabilities NET_ADMIN NET_RAW
    disabled
    seclabel u:r:recovery:s0

service dhcpcd /system/bin/dhcpcd wlan0 -B
    class main
    user root
    group root inet net_admin
    capabilities NET_ADMIN NET_RAW
    disabled
    oneshot
    seclabel u:r:recovery:s0
